---
import "@fontsource-variable/space-grotesk";
import "@/styles/global.css";
import { contenido, perfil, rutaDe, type Idioma } from "@/i18n/content";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = contenido[idioma];
const canonica = new URL(rutaDe(idioma), Astro.site);
const imagen = new URL(`/og-${idioma}.png`, Astro.site);

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: perfil.nombre,
  url: new URL("/", Astro.site).href,
  email: `mailto:${perfil.correo}`,
  jobTitle: t.meta.cargo,
  description: t.meta.descripcion,
  address: { "@type": "PostalAddress", addressLocality: "Ambato", addressCountry: "EC" },
  sameAs: [perfil.github, perfil.linkedin],
  knowsAbout: [
    ".NET",
    "Angular",
    "React",
    "Next.js",
    "NestJS",
    "Python",
    "FastAPI",
    "Oracle Database",
    "PostgreSQL",
    "Docker",
    "TypeScript",
  ],
};
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.titulo}</title>
    <meta name="description" content={t.meta.descripcion} />
    <meta name="author" content={perfil.nombre} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={new URL(rutaDe("es"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(rutaDe("en"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(rutaDe("es"), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f3fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0b10" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:title" content={t.meta.titulo} />
    <meta property="og:description" content={t.meta.descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={idioma === "es" ? "es_EC" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const tema = localStorage.getItem("tema");
        if (tema === "light" || tema === "dark") document.documentElement.dataset.theme = tema;
      } catch {}
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="boton boton-primario sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {t.controles.saltar}
    </a>
    <slot />
  </body>
</html>
